{
	"schemaVersion": 1,
	"id": "entity-area-logger",
	"version": "${version}",
	"name": "Entity Area Logger",
	"description": "Logs Mobs in Area by type each tick",
	"authors": [
		"DeimosTech"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/entity-area-logger/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.entityarealogger.EntityAreaLogger"
		],
		"client": [
			"com.entityarealogger.client.EntityAreaLoggerClient"
		]
	},
	"mixins": [
		"entity-area-logger.mixins.json",
		{
			"config": "entity-area-logger.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}